<%
  require 'json'

  eessi_release = "2025.06"
  software_name = "JupyterNotebook"
  pinned_module = ""
  fallback_modules = [{"module": "JupyterNotebook/7.4.7-GCCcore-14.3.0", "version": "7.4.7"}, {"module": "JupyterNotebook/7.4.4-GCCcore-14.2.0", "version": "7.4.4"}, {"module": "JupyterNotebook/7.2.3-GCCcore-13.3.0", "version": "7.2.3"}]

  format_option = lambda do |v|
    mod = (v['module'] || v[:module]).to_s
    ver = (v['version'] || v[:version]).to_s.strip
    mod_ver = (v['module_version'] || v[:module_version]).to_s.strip

    if mod_ver.empty? && mod.include?('/')
      mod_ver = mod.split('/', 2)[1]
    end

    display_ver = !mod_ver.empty? ? mod_ver : ver
    label = display_ver.empty? ? mod : "#{software_name} #{display_ver}"
    [label, mod]
  end

  catalog_candidates = [
    "/var/cache/eessi-ood/eessi_catalog_#{eessi_release}.json",
    "/var/cache/eessi-ood/eessi_catalog.json"
  ]

  @resolved_modules = []

  if !pinned_module.empty?
    @resolved_modules = fallback_modules.map(&format_option)
  else
    catalog_path = catalog_candidates.find { |p| File.readable?(p) }
    if catalog_path
      begin
        data = JSON.parse(File.read(catalog_path))
        if data['eessi_version'].to_s == eessi_release
          entries = data.dig('software', software_name, 'versions') || []
          @resolved_modules = entries.map(&format_option)
        end
      rescue StandardError
        @resolved_modules = []
      end
    end
  end

  if @resolved_modules.empty?
    @resolved_modules = fallback_modules.map(&format_option)
  end
%>

---
cluster: "*"

attributes:

  eessi_module:
    widget: "select"
    label: "Jupyter Notebook - EESSI version"
    help: "Select the version provided by EESSI."
    options:
    <% @resolved_modules.each do |label, mod| %>
      - ["<%= label %>", "<%= mod %>"]
    <% end %>
    value: "<%= @resolved_modules.first&.last %>"
    required: true

  extra_app_args:
    widget: "text_field"
    label: "Additional Jupyter arguments"
    value: ""
    help: "Optional additional arguments passed to Jupyter Notebook - EESSI."
    required: false

  num_cores:
    widget: "number_field"
    min: 1
    max: 64
    step: 1
    value: 1
    label: "Number of cores"

  custom_memory_per_node:
    widget: "number_field"
    label: "Memory Allocation in GB"
    min: 1
    max: 50
    step: 1
    value: 8

  working_dir:
    widget: "path_selector"
    label: "Working Directory"
    data-target-file-type: dirs

form:
  - eessi_module
  - extra_app_args
  - bc_num_hours
  - num_cores
  - custom_memory_per_node
  - working_dir
