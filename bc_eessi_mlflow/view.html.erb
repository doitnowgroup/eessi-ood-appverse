<script type="text/javascript">
(function () {
  var host = "<%= host %>";
  var port = "<%= port %>";
  var password = "<%= password %>";
  var targetUrl = window.location.protocol + "//ood:" + encodeURIComponent(password) + "@" + window.location.host + "/node/" + host + "/" + port + "/";
  var form = document.getElementById("mlflow-connect-form");
  if (form) {
    form.action = targetUrl;
  }
})();
</script>

<div class="alert alert-info">
  <strong>Session Password:</strong> <code><%= password %></code> (Username: <code>ood</code>)
</div>

<form id="mlflow-connect-form" action="/node/<%= host %>/<%= port %>/" method="get" target="_blank">
  <button class="btn btn-primary" type="submit">
    <i class="fa fa-eye"></i> Connect to MLflow
  </button>
</form>
