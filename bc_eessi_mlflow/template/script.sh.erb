#!/usr/bin/env bash

set -euo pipefail


# ----------------------------------------------------------------------
# Validate environment
# ----------------------------------------------------------------------

: "${APP_EXECUTABLE_PATH:?MLflow executable is missing}"
: "${OOD_WD:?Working directory is missing}"
: "${host:?Host is missing}"
: "${port:?Port is missing}"
: "${mlflow_port:?Internal MLflow port is missing}"
: "${password:?Session password is missing}"
: "${MLFLOW_PREFIX:?MLflow proxy prefix is missing}"


# ----------------------------------------------------------------------
# Create private session storage
# ----------------------------------------------------------------------

umask 077

MLFLOW_STATE="$(mktemp -d "/tmp/ood-mlflow-${USER}-XXXXXX")"
MLFLOW_PID=""

cleanup() {
    if [[ -n "${MLFLOW_PID}" ]] && kill -0 "${MLFLOW_PID}" 2>/dev/null; then
        kill "${MLFLOW_PID}" 2>/dev/null || true
        wait "${MLFLOW_PID}" 2>/dev/null || true
    fi
    rm -rf -- "${MLFLOW_STATE}"
}

trap cleanup EXIT INT TERM

mkdir -p "${MLFLOW_STATE}/artifacts"


# ----------------------------------------------------------------------
# MLflow storage configuration
# ----------------------------------------------------------------------

MLFLOW_BACKEND_URI="sqlite:///${MLFLOW_STATE}/tracking.db"
MLFLOW_ARTIFACTS_DIR="${MLFLOW_STATE}/artifacts"
PROXY_BIND_HOST="${OOD_APP_BIND_HOST:-${host}}"


# ----------------------------------------------------------------------
# Start internal MLflow Server on loopback and Authenticated Proxy
# ----------------------------------------------------------------------

cd "${OOD_WD}"

echo "Starting internal MLflow Server on 127.0.0.1:${mlflow_port}..."
echo "Proxy Host: ${PROXY_BIND_HOST}"
echo "Proxy Port: ${port}"
echo "Executable: ${APP_EXECUTABLE_PATH}"

"${APP_EXECUTABLE_PATH}" server \
    --host 127.0.0.1 \
    --port "${mlflow_port}" \
    --workers 1 \
    --backend-store-uri "${MLFLOW_BACKEND_URI}" \
    --artifacts-destination "${MLFLOW_ARTIFACTS_DIR}" \
    --serve-artifacts \
    --static-prefix "${MLFLOW_PREFIX}" &
MLFLOW_PID=$!

for _ in $(seq 1 30); do
    if python3 -c "import socket; s=socket.create_connection(('127.0.0.1', int('${mlflow_port}')), 0.5); s.close()" 2>/dev/null; then
        break
    fi
    sleep 1
done

export PROXY_BIND_HOST
exec python3 - <<'PY'
import base64
import hashlib
import hmac
import http.client
from http.cookies import SimpleCookie
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import os
from urllib.parse import parse_qs, urlsplit

BIND_HOST = os.environ["PROXY_BIND_HOST"]
LISTEN_PORT = int(os.environ["port"])
TARGET_PORT = int(os.environ["mlflow_port"])
PREFIX = os.environ["MLFLOW_PREFIX"].rstrip("/")
PASSWORD = os.environ["password"]
COOKIE_NAME = "ood_mlflow_session"
COOKIE_TOKEN = hmac.new(PASSWORD.encode("utf-8"), b"mlflow-ood-session", hashlib.sha256).hexdigest()
EXPECTED_BASIC = base64.b64encode(f"ood:{PASSWORD}".encode("utf-8")).decode("ascii")


class AuthProxyHandler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def _authorized(self):
        cookie_hdr = self.headers.get("Cookie", "")
        if cookie_hdr:
            cookies = SimpleCookie()
            cookies.load(cookie_hdr)
            if COOKIE_NAME in cookies and hmac.compare_digest(cookies[COOKIE_NAME].value, COOKIE_TOKEN):
                return True
        auth = self.headers.get("Authorization", "")
        if auth.startswith("Basic "):
            token = auth.split(" ", 1)[1].strip()
            if hmac.compare_digest(token, EXPECTED_BASIC):
                return True
        return False

    def _render_login(self, error_msg=""):
        err_html = f'<p style="color:#b91c1c;">{error_msg}</p>' if error_msg else ""
        html = f"""<!doctype html>
<html><head><meta charset="utf-8"><title>MLflow Login</title></head>
<body style="font-family:sans-serif;max-width:420px;margin:4rem auto;">
<h2>MLflow Session Authentication</h2>
{err_html}
<form method="post" action="{PREFIX}/ood-login">
<label>Session Password:<br><input type="password" name="password" autofocus style="width:100%;padding:8px;margin:8px 0;"></label>
<button type="submit" style="padding:8px 16px;">Sign in</button>
</form></body></html>""".encode("utf-8")
        self.send_response(401)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(html)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(html)

    def _handle_login(self):
        content_len = int(self.headers.get("Content-Length", "0"))
        raw = self.rfile.read(content_len).decode("utf-8", errors="replace")
        submitted = parse_qs(raw).get("password", [""])[0]
        if hmac.compare_digest(submitted, PASSWORD):
            self.send_response(302)
            self.send_header("Location", f"{PREFIX}/")
            self.send_header("Set-Cookie", f"{COOKIE_NAME}={COOKIE_TOKEN}; Path={PREFIX}/; HttpOnly; SameSite=Lax")
            self.send_header("Content-Length", "0")
            self.send_header("Connection", "close")
            self.end_headers()
        else:
            self._render_login("Invalid session password.")

    def _proxy(self):
        req_path = urlsplit(self.path).path
        if self.command == "POST" and req_path.endswith("/ood-login"):
            self._handle_login()
            return

        if not self._authorized():
            self._render_login()
            return

        content_len = int(self.headers.get("Content-Length", "0"))
        body = self.rfile.read(content_len) if content_len > 0 else None

        fwd_headers = {
            k: v
            for k, v in self.headers.items()
            if k.lower() not in ("host", "authorization", "connection", "proxy-connection", "keep-alive", "transfer-encoding")
        }
        fwd_headers["Host"] = f"127.0.0.1:{TARGET_PORT}"
        fwd_headers["Connection"] = "close"

        conn = http.client.HTTPConnection("127.0.0.1", TARGET_PORT, timeout=60)
        try:
            conn.request(self.command, self.path, body=body, headers=fwd_headers)
            resp = conn.getresponse()
            resp_body = resp.read()

            self.send_response(resp.status, resp.reason)
            for k, v in resp.getheaders():
                if k.lower() not in ("transfer-encoding", "connection", "keep-alive", "content-length"):
                    self.send_header(k, v)
            self.send_header("Content-Length", str(len(resp_body)))
            self.send_header("Connection", "close")
            self.end_headers()
            self.wfile.write(resp_body)
        finally:
            conn.close()

    def do_GET(self): self._proxy()
    def do_POST(self): self._proxy()
    def do_PUT(self): self._proxy()
    def do_DELETE(self): self._proxy()
    def do_PATCH(self): self._proxy()
    def do_HEAD(self): self._proxy()
    def do_OPTIONS(self): self._proxy()

    def log_message(self, fmt, *args):
        pass


server = ThreadingHTTPServer((BIND_HOST, LISTEN_PORT), AuthProxyHandler)
server.serve_forever()
PY
