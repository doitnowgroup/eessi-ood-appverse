#!/usr/bin/env bash

set -euo pipefail

# Validate the environment prepared by the EESSI runtime.
: "${APP_EXECUTABLE_PATH:?gnuplot executable is missing}"
: "${OOD_WD:?Working directory is missing}"
: "${DISPLAY:?VNC display is missing}"

SESSION_OUTPUT_DIR="$PWD"

cd "${OOD_WD}"

echo "Starting gnuplot..."
echo "EESSI module: ${EESSI_MODULE:-unknown}"
echo "Executable: ${APP_EXECUTABLE_PATH}"
echo "Working directory: ${OOD_WD}"
echo "DISPLAY: ${DISPLAY}"

# ------------------------------------------------------------
# Fix Openbox theme discovery
# ------------------------------------------------------------

export XDG_DATA_DIRS="/usr/local/share:/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"

echo "XDG_DATA_DIRS=${XDG_DATA_DIRS}"

# ------------------------------------------------------------
# Start Openbox
# ------------------------------------------------------------

echo "Starting Openbox..."

/usr/bin/openbox \
  > "${SESSION_OUTPUT_DIR}/window-manager.log" 2>&1 &

WM_PID=$!

trap 'kill "${WM_PID}" 2>/dev/null || true' EXIT

# Launch gnuplot inside a graphical terminal.
# The OOD job stays active while this terminal is open.
/usr/bin/xterm \
  -T "gnuplot - EESSI" \
  -geometry 110x34 \
  -e "${APP_EXECUTABLE_PATH}" -persist

echo "gnuplot session finished."
