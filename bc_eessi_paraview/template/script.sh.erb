#!/usr/bin/env bash

set -euo pipefail

# ------------------------------------------------------------
# Validate environment
# ------------------------------------------------------------

: "${APP_EXECUTABLE_PATH:?ParaView executable is missing}"
: "${OOD_WD:?Working directory is missing}"
: "${DISPLAY:?VNC display is missing}"

cd "${OOD_WD}"

echo "Starting ParaView..."
echo "EESSI module: ${EESSI_MODULE}"
echo "Executable: ${APP_EXECUTABLE_PATH}"
echo "Working directory: ${OOD_WD}"
echo "DISPLAY: ${DISPLAY}"

# ------------------------------------------------------------
# Start Openbox
# ------------------------------------------------------------

/usr/bin/openbox > window-manager.log 2>&1 &

WM_PID=$!

trap 'kill "${WM_PID}" 2>/dev/null || true' EXIT

# ------------------------------------------------------------
# Launch ParaView
# ------------------------------------------------------------

export QT_X11_NO_MITSHM=1

"${APP_EXECUTABLE_PATH}"

echo "ParaView exited."
