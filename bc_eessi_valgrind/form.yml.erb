<%
  require 'json'

  eessi_release = "2023.06"
  software_name = "Valgrind"
  pinned_module = ""
  fallback_modules = [{"module": "Valgrind/3.23.0-gompi-2023b", "version": "3.23.0"}, {"module": "Valgrind/3.21.0-gompi-2022b", "version": "3.21.0"}, {"module": "Valgrind/3.21.0-gompi-2023a", "version": "3.21.0"}]

  format_option = lambda do |v|
    mod = (v['module'] || v[:module]).to_s
    ver = (v['version'] || v[:version]).to_s.strip
    mod_ver = (v['module_version'] || v[:module_version]).to_s.strip

    if mod_ver.empty? && mod.include?('/')
      mod_ver = mod.split('/', 2)[1]
    end

    display_ver = !mod_ver.empty? ? mod_ver : ver
    label = display_ver.empty? ? mod : "#{software_name} #{display_ver}"
    [label, mod]
  end

  catalog_candidates = [
    "/var/cache/eessi-ood/eessi_catalog_#{eessi_release}.json",
    "/var/cache/eessi-ood/eessi_catalog.json"
  ]

  @resolved_modules = []

  if !pinned_module.empty?
    @resolved_modules = fallback_modules.map(&format_option)
  else
    catalog_path = catalog_candidates.find { |p| File.readable?(p) }
    if catalog_path
      begin
        data = JSON.parse(File.read(catalog_path))
        if data['eessi_version'].to_s == eessi_release
          entries = data.dig('software', software_name, 'versions') || []
          @resolved_modules = entries.map(&format_option)
        end
      rescue StandardError
        @resolved_modules = []
      end
    end
  end

  if @resolved_modules.empty?
    @resolved_modules = fallback_modules.map(&format_option)
  end
%>

---
cluster: "*"
attributes:

  eessi_module:
    widget: "select"
    label: "Valgrind version"
    help: "Select a Valgrind version provided by EESSI 2023.06."
    options:
    <% @resolved_modules.each do |label, mod| %>
      - ["<%= label %>", "<%= mod %>"]
    <% end %>
    value: "<%= @resolved_modules.first&.last %>"
    required: true

  valgrind_tool:
    widget: "select"
    label: "Default Valgrind tool"
    help: "Select the Valgrind tool shown in the terminal examples."
    options:
      - ["Memcheck - memory error detector", "memcheck"]
      - ["Massif - heap profiler", "massif"]
      - ["Callgrind - call-graph profiler", "callgrind"]
      - ["Cachegrind - cache profiler", "cachegrind"]
      - ["Helgrind - thread error detector", "helgrind"]
      - ["DRD - thread error detector", "drd"]
    value: "memcheck"
    required: true

  working_dir:
    widget: "path_selector"
    label: "Working Directory"
    help: "Directory where the Valgrind terminal will start."
    value: ""
    show_files: false
    show_hidden: false
    popup_title: "Select Working Directory"

form:
  - eessi_module
  - valgrind_tool
  - bc_num_hours
  - working_dir
